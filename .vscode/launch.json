{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MediCare Dental - API (Android Emulator)",
            "cwd": "${workspaceFolder}/frontend",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/frontend/lib/main.dart",
            "deviceId": "emulator-5554",
            "toolArgs": [
                "--dart-define=DATA_SOURCE=api",
                "--dart-define=API_BASE_URL=http://10.0.2.2:3000"
            ]
        },
        {
            "name": "MediCare Dental - Mock (Demo)",
            "cwd": "${workspaceFolder}/frontend",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/frontend/lib/main.dart",
            "deviceId": "emulator-5554",
            "toolArgs": [
                "--dart-define=DATA_SOURCE=mock"
            ]
        },
        {
            "name": "MediCare Dental - API (Android Emulator, profile)",
            "cwd": "${workspaceFolder}/frontend",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/frontend/lib/main.dart",
            "deviceId": "emulator-5554",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define=DATA_SOURCE=api",
                "--dart-define=API_BASE_URL=http://10.0.2.2:3000"
            ]
        },
        {
            "name": "MediCare Dental - API (Android Emulator, release)",
            "cwd": "${workspaceFolder}/frontend",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/frontend/lib/main.dart",
            "deviceId": "emulator-5554",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define=DATA_SOURCE=api",
                "--dart-define=API_BASE_URL=http://10.0.2.2:3000"
            ]
        }
    ]
}
