{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MediCare Dental (Mock Android)",
            "cwd": "${workspaceFolder}/frontend",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/frontend/lib/main.dart",
            "deviceId": "emulator-5554",
            "toolArgs": [
                "--dart-define=DATA_SOURCE=mock"
            ]
        },
        {
            "name": "backend",
            "cwd": "${workspaceFolder}/backend",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/backend/bin/server.dart"
        },
        {
            "name": "frontend",
            "cwd": "${workspaceFolder}/frontend",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/frontend/lib/main.dart"
        },
        {
            "name": "frontend (Android emulator)",
            "cwd": "${workspaceFolder}/frontend",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/frontend/lib/main.dart",
            "toolArgs": [
                "--dart-define=API_URL=http://10.0.2.2:8080"
            ]
        },
        {
            "name": "frontend (profile mode)",
            "cwd": "${workspaceFolder}/frontend",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/frontend/lib/main.dart",
            "flutterMode": "profile"
        },
        {
            "name": "frontend (release mode)",
            "cwd": "${workspaceFolder}/frontend",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/frontend/lib/main.dart",
            "flutterMode": "release"
        }
    ],
    "compounds": [
        {
            "name": "Full stack (Android emulator)",
            "configurations": [
                "backend",
                "frontend (Android emulator)"
            ],
            "stopAll": true
        }
    ]
}
